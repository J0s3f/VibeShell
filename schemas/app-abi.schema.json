{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://j0s.at/vibeshell/schemas/v1/app-abi.schema.json",
  "title": "VibeShell generated-application artifact / event / result ABI",
  "description": "Immutable app artifact plus the bounded event-in/result-out ABI between the service and sandboxed JavaScript (PLAN 5.6, 6.2). Guests receive bounded inputs and return new state, a declarative view, effect proposals, world-read requests, or an AI-extension request. A guest may also ask to stay foreground for the next input line (awaiting_input) and name the continuation prompt (prompt); an input event while it is foreground carries {\"line\", \"args\"}. Contract version 1.",
  "version": 1,
  "type": "object",
  "required": ["artifact", "event", "result"],
  "properties": {
    "artifact": { "$ref": "#/$defs/artifact" },
    "event": { "$ref": "#/$defs/appEvent" },
    "result": { "$ref": "#/$defs/appResult" }
  },
  "additionalProperties": false,
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[a-z]{2,3}_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "artifact": {
      "type": "object",
      "required": ["app_id", "version_id", "manifest", "source", "source_hash", "owner", "scope", "created_at", "provenance", "validation"],
      "properties": {
        "app_id": { "$ref": "#/$defs/identity" },
        "version_id": { "$ref": "#/$defs/identity" },
        "parent_version": { "$ref": "#/$defs/identity" },
        "manifest": {
          "type": "object",
          "required": ["abi_version", "command_names", "description", "state_schema", "capabilities", "entrypoint", "version"],
          "properties": {
            "abi_version": { "const": 1 },
            "command_names": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
            "description": { "type": "string", "maxLength": 1024 },
            "state_schema": { "type": "object" },
            "capabilities": {
              "type": "array",
              "items": { "enum": ["file.read", "file.write", "file.list", "fact.read", "fact.write", "process.spawn", "network", "time", "random"] }
            },
            "entrypoint": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "source": { "type": "string", "maxLength": 1048576 },
        "source_hash": { "$ref": "#/$defs/identity" },
        "owner": { "$ref": "#/$defs/identity" },
        "scope": { "enum": ["session", "user", "shared", "baseline"] },
        "created_at": { "type": "integer", "minimum": 0 },
        "provenance": { "type": "object" },
        "validation": {
          "type": "object",
          "required": ["passed", "validated_at", "validator_version"],
          "properties": {
            "passed": { "type": "boolean" },
            "issues": { "type": "array", "items": { "type": "string" } },
            "validated_at": { "type": "integer", "minimum": 0 },
            "validator_version": { "type": "string" }
          },
          "additionalProperties": false
        },
        "activated_at": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "appEvent": {
      "type": "object",
      "required": ["event_type", "payload", "timestamp"],
      "properties": {
        "event_type": { "enum": ["input", "timer", "resize", "ai_request", "world_change"] },
        "payload": { "type": "object" },
        "timestamp": { "type": "integer", "minimum": 0 },
        "session_id": { "$ref": "#/$defs/identity" },
        "turn_id": { "$ref": "#/$defs/identity" }
      },
      "additionalProperties": false
    },
    "appResult": {
      "type": "object",
      "required": ["new_state", "view", "exited"],
      "properties": {
        "new_state": {
          "type": "object",
          "properties": {
            "session_state": { "type": "object" },
            "user_state": { "type": "object" },
            "shared_state": { "type": "object" }
          },
          "additionalProperties": false
        },
        "view": { "$ref": "#/$defs/appView" },
        "effects": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["mutation", "sync"],
            "properties": {
              "mutation": { "type": "object" },
              "sync": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "world_reads": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["request_id", "scope"],
            "properties": {
              "request_id": { "type": "string", "minLength": 1 },
              "scope": { "enum": ["session", "user", "shared", "baseline"] },
              "path": { "type": "string" },
              "node_id": { "$ref": "#/$defs/identity" },
              "max_bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 }
            },
            "additionalProperties": false
          }
        },
        "ai_request": {
          "type": "object",
          "required": ["request_id", "prompt", "max_tokens", "timeout_ms"],
          "properties": {
            "request_id": { "type": "string", "minLength": 1 },
            "prompt": { "type": "string", "minLength": 1, "maxLength": 8192 },
            "context": { "type": "object" },
            "max_tokens": { "type": "integer", "minimum": 1 },
            "timeout_ms": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "exited": { "type": "boolean" },
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "awaiting_input": { "type": "boolean" },
        "prompt": { "type": "string", "maxLength": 64 }
      },
      "additionalProperties": false
    },
    "appView": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["text", "form", "table", "editor", "pager", "status"] },
        "buffer_ref": {
          "type": "object",
          "required": ["hash", "size", "media_type"],
          "properties": {
            "hash": { "$ref": "#/$defs/identity" },
            "size": { "type": "integer", "minimum": 0 },
            "media_type": { "type": "string" }
          },
          "additionalProperties": false
        },
        "cursor": {
          "type": "object",
          "required": ["row", "col"],
          "properties": {
            "row": { "type": "integer", "minimum": 0 },
            "col": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "viewport": {
          "type": "object",
          "required": ["top", "left", "height", "width"],
          "properties": {
            "top": { "type": "integer", "minimum": 0 },
            "left": { "type": "integer", "minimum": 0 },
            "height": { "type": "integer", "minimum": 0 },
            "width": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "metadata": { "type": "object" },
        "status_line": { "type": "string", "maxLength": 512 },
        "key_bindings": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["key", "action"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "action": { "enum": ["move_cursor", "edit_buffer", "select_range", "search_buffer", "scroll", "update_status", "mode_switch", "emit_event"] },
              "params": { "type": "object" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
