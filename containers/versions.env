# Pinned toolchain and base images for VibeShell container builds.
#
# Every entry is passed to `podman build` as `--build-arg NAME=VALUE` by
# scripts/dev.ps1 and mirrors an ARG default in containers/Containerfile.
# dev.ps1 refuses to build when the two disagree, so this file stays the single
# place to update when a patch release or base image changes.
#
# Update procedure: change the value here, keep the Containerfile ARG default
# identical, rebuild the images, and record the new digest in docs/development.md.

GO_VERSION=1.27.1
GO_IMAGE=docker.io/library/golang:1.27.1-bookworm@sha256:69a7b9788769bec032d238959b61854e9ae87f57be9029ec04e9885fabf99195
RUNTIME_IMAGE=docker.io/library/debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
