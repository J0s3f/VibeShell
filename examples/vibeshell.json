{
  "version": 1,
  "identity": {
    "system_name": "VibeOS",
    "shell_name": "VibeShell",
    "hostname": "vibeshell.example"
  },
  "ssh": {
    "listen_address": "0.0.0.0",
    "listen_port": 2222,
    "host_key_file": "/etc/vibeshell/host_key",
    "max_connections": 512,
    "idle_timeout_ms": 300000,
    "handshake_timeout_ms": 10000,
    "max_terminal_rows": 200,
    "max_terminal_cols": 512
  },
  "auth": {
    "mode": "secure",
    "password_file": "/etc/vibeshell/passwords.json",
    "max_attempts_per_connection": 6,
    "max_concurrent_auth": 2,
    "failed_attempts_per_minute": 30
  },
  "sharing": {
    "enabled": true,
    "policy_revision": 3
  },
  "world": {
    "baseline_version": "v1",
    "max_objects": 100000,
    "max_content_bytes": 268435456,
    "materialization_budget_bytes": 4194304,
    "max_staged_changes": 256,
    "conflict_retries": 3
  },
  "apps": {
    "engine_abi_version": "v1",
    "max_source_bytes": 65536,
    "max_state_bytes": 1048576,
    "heap_limit_bytes": 16777216,
    "stack_limit_bytes": 1048576,
    "execution_deadline_ms": 30000,
    "instance_pool_size": 4,
    "max_generations": 8,
    "max_repairs": 2
  },
  "terminal": {
    "scrollback_lines": 2000,
    "max_paste_bytes": 65536,
    "redraw_policy": "diff",
    "refresh_budget_lines": 24,
    "completion_cache": "session"
  },
  "prompts": {
    "motd": "../prompts/v1/motd.txt",
    "shell_behavior": "../prompts/v1/shell-behavior.txt",
    "app_generation": "../prompts/v1/app-generation.txt",
    "app_extension": "../prompts/v1/app-extension.txt",
    "world_materialization": "../prompts/v1/world-materialization.txt",
    "summary": "../prompts/v1/summary-repair.txt",
    "repair": "../prompts/v1/summary-repair.txt"
  },
  "providers": [
    {
      "name": "opencode",
      "products": [
        {
          "name": "console",
          "base_url": "https://opencode.example.internal",
          "protocols": ["chat", "messages"],
          "default_protocol": "chat"
        }
      ]
    },
    {
      "name": "opencode-go",
      "products": [
        {
          "name": "go",
          "base_url": "https://opencode-go.example.internal",
          "protocols": ["responses"],
          "default_protocol": "responses"
        }
      ]
    }
  ],
  "routes": [
    { "id": "rte_0123456789ABCDEFGHJKMNPQRS", "provider": "opencode", "product": "console", "model": "ling-3.1-flash-free", "protocol": "chat" },
    { "id": "rte_0123456789ABCDEFGHJKMNPQRT", "provider": "opencode", "product": "console", "model": "deepseek-v4.1-flash-free", "protocol": "chat" },
    { "id": "rte_0123456789ABCDEFGHJKMNPQRV", "provider": "opencode", "product": "console", "model": "qwen3.6-flash-free", "protocol": "messages" },
    { "id": "rte_0123456789ABCDEFGHJKMNPQRW", "provider": "opencode", "product": "console", "model": "opencode-free-auto", "protocol": "chat" },
    { "id": "rte_0123456789ABCDEFGHJKMNPQR5", "provider": "opencode-go", "product": "go", "model": "ling-3.1-flash", "protocol": "responses" },
    { "id": "rte_0123456789ABCDEFGHJKMNPQR6", "provider": "opencode-go", "product": "go", "model": "deepseek-v4.1-flash", "protocol": "responses" }
  ],
  "accounts": [
    {
      "id": "acc_0123456789ABCDEFGHJKMNPQRS",
      "quota_group": "team-a",
      "permitted_products": ["console", "go"],
      "secret_ref": "{file:/etc/vibeshell/secrets/opencode-primary.key}"
    },
    {
      "id": "acc_0123456789ABCDEFGHJKMNPQRT",
      "quota_group": "payg",
      "permitted_products": ["go"],
      "secret_ref": "{env:VIBESHELL_OPENCODE_GO_KEY}"
    }
  ],
  "account_pools": {
    "payg": ["acc_0123456789ABCDEFGHJKMNPQRT"]
  },
  "tiers": [
    {
      "name": "named-free",
      "routes": [
        "rte_0123456789ABCDEFGHJKMNPQRS",
        "rte_0123456789ABCDEFGHJKMNPQRT",
        "rte_0123456789ABCDEFGHJKMNPQRV"
      ]
    },
    {
      "name": "free-discovery",
      "routes": ["rte_0123456789ABCDEFGHJKMNPQRW"],
      "auto_free": true
    },
    {
      "name": "go-native",
      "routes": [
        "rte_0123456789ABCDEFGHJKMNPQR5",
        "rte_0123456789ABCDEFGHJKMNPQR6"
      ]
    },
    {
      "name": "cheap-payg",
      "routes": [
        "rte_0123456789ABCDEFGHJKMNPQR5",
        "rte_0123456789ABCDEFGHJKMNPQR6"
      ],
      "account_pool": "payg"
    }
  ],
  "discovery": {
    "refresh_interval_ms": 60000,
    "stale_age_ms": 600000,
    "metadata_url": "https://catalogue.example.internal/routes.json",
    "min_context_tokens": 8192,
    "capabilities": ["tool_call", "text_input", "text_output"]
  },
  "health": {
    "max_concurrent_probes": 4,
    "probe_interval_ms": 30000,
    "max_probes_per_hour": 120,
    "initial_backoff_ms": 500,
    "max_backoff_ms": 60000,
    "jitter_ratio": 0.2,
    "reset_grace_ms": 5000
  },
  "limits": {
    "turn_deadline_ms": 120000,
    "max_attempts": 4,
    "max_output_bytes": 1048576,
    "max_content_bytes": 4194304
  },
  "inference": {
    "request_deadline_ms": 30000,
    "max_steps": 16,
    "max_output_tokens": 65536,
    "global_concurrency": 2,
    "max_account_concurrency": 2,
    "wait_queue_depth": 16
  },
  "spending": {
    "session_limit_usd": 25,
    "unknown_cost_policy": "deny"
  },
  "persistence": {
    "database_path": "/var/lib/vibeshell/world.db",
    "durability": "FULL",
    "backup_dir": "/var/backups/vibeshell",
    "writer_queue_depth": 64,
    "backup_interval_ms": 3600000,
    "event_retention": "permanent"
  },
  "exports": {
    "output_dir": "/var/lib/vibeshell/exports",
    "formats": ["jsonl", "transcript"],
    "max_concurrent_jobs": 2,
    "max_export_bytes": 67108864,
    "redact_secrets": true
  },
  "operations": {
    "log_level": "info",
    "health_check_interval_ms": 5000,
    "shutdown_grace_ms": 5000,
    "instrumentation": "logs"
  }
}
