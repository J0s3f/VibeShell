    "source": "// Generated artifact for the invoked program. Bounded guest only.\nexport function onEvent(state, event) {\n  const base = state.session_state || { rows: [], selected: 0 };\n  const rows = event.rows || base.rows;\n  const selected = event.key === 'down'\n    ? Math.min(base.selected + 1, Math.max(rows.length - 1, 0))\n    : event.key === 'up'\n      ? Math.max(base.selected - 1, 0)\n      : base.selected;\n  return {\n    newState: { session_state: { rows: rows, selected: selected } },\n    view: {\n      mode: 'table',\n      cursor: { row: selected, col: 0 },\n      status_line: rows.length + ' tasks',\n      key_bindings: [\n        { key: 'up', action: 'move_cursor' },\n        { key: 'down', action: 'move_cursor' },\n        { key: 'q', action: 'emit_event' }\n      ]\n    },\n    effects: [],\n    worldReads: []\n  };\n}\n",
