    "source": "// Generated artifact: a line-based interactive session. Bounded guest only.\nexport function onEvent(state, event) {\n  const base = state.session_state || { turns: 0 };\n  const line = (event.line || '').trim();\n  const turns = base.turns + 1;\n  const done = line === 'quit' || line === 'exit';\n  return {\n    newState: { session_state: { turns: turns, last: line } },\n    view: { mode: 'text', status_line: turns + ' turns' },\n    effects: [],\n    worldReads: [],\n    awaiting_input: !done,\n    prompt: done ? '' : 'grove> ',\n    exited: done\n  };\n}\n",
