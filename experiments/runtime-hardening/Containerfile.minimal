# Attack-surface evaluation artifact (NOT the shipped Containerfile).
#
# ADR 0008 leaves attack-surface reduction open. This variant is a measurement
# only: it builds the same static binary and copies only the binary and the CA
# root bundle onto `scratch`, relying on a numeric non-root UID instead of a
# created account. It removes apt/dpkg, the shells, perl, openssl, tar/gzip, and
# every setuid binary by construction. It is not proposed as the shipped image
# because it loses the `/etc/passwd` entry, any shell for debugging, and the
# ability to install a package, and because ca-certificates must be refreshed
# from the build stage.
#
# Build:  podman build -f experiments/runtime-hardening/Containerfile.minimal \
#             --target runtime --tag localhost/vibeshell-runtime:minimal .
ARG GO_IMAGE=docker.io/library/golang:1.27.1-bookworm@sha256:69a7b9788769bec032d238959b61854e9ae87f57be9029ec04e9885fabf99195

FROM ${GO_IMAGE} AS build
ENV CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOTOOLCHAIN=local
WORKDIR /src
COPY . .
RUN go build -trimpath \
        -ldflags "-s -w -X j0s.at/vibeshell/internal/buildinfo.version=dev" \
        -o /out/vibeshell ./cmd/vibeshell

FROM scratch AS runtime
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/vibeshell /usr/local/bin/vibeshell
USER 10001:10001
WORKDIR /home/vibeshell
EXPOSE 2222
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/vibeshell"]
